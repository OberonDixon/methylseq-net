ref_genome = '/clusterfs/nilah/oberon/genomes/hg38.fa'
regions_bed = '/clusterfs/nilah/oberon/datasets/basenji2_human_training/sequences.bed'
methylation_directory = '/global/scratch/users/dixonluinenburg/methylation_atlas/GSE186458_RAW'
atac_directory = '/global/scratch/users/dixonluinenburg/atac_atlas/bigwigs'
cage_directory = '/global/scratch/users/dixonluinenburg/cage_atlas/hg38_v9'
match_file = '/clusterfs/nilah/oberon/repos/methylseq-net/configs/cell_type_matching_atac-cage.tsv'
output_directory = '/global/scratch/users/dixonluinenburg/atlas_datasets/bisulfite-atac-cage/'
label_bin_size = 128
label_num_bins = 1024
seq_length = 131072

DatasetWriter.track_length = %label_num_bins
DatasetWriter.seq_length = %seq_length
DatasetWriter.cpg_input = True
DatasetWriter.mask = True

RegionBedParser.regions_bed = %regions_bed

MethylAtacCageAtlases.ref_genome = %ref_genome
MethylAtacCageAtlases.methylation_directory = %methylation_directory
MethylAtacCageAtlases.atac_directory = %atac_directory
MethylAtacCageAtlases.cage_directory = %cage_directory
MethylAtacCageAtlases.match_file = %match_file
MethylAtacCageAtlases.label_bin_size = %label_bin_size
MethylAtacCageAtlases.label_num_bins = %label_num_bins
MethylAtacCageAtlases.normalize_label_counts = False
MethylAtacCageAtlases.normalize_label_gc = False
MethylAtacCageAtlases.binarize_labels = False

PreprocessingPipeline.sample_generator = @RegionBedParser()
PreprocessingPipeline.multitask_io_handler = @MethylAtacCageAtlases()
PreprocessingPipeline.dataset_writer_class = @DatasetWriter
PreprocessingPipeline.output_directory = %output_directory



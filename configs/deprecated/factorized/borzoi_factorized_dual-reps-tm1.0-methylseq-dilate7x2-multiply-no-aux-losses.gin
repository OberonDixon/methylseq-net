initial_filters = 40
dilated_residual_filters = 40

methylseqnet.transforms.ReverseComplement.probability=0.5
methylseqnet.transforms.ReverseComplement.batch_wise=False

methylseqnet.transforms.SequenceJitter.stdev=1
methylseqnet.transforms.SequenceJitter.max_jitter=3
methylseqnet.transforms.SequenceJitter.batch_wise=False

seq_model/methylseqnet.transforms.EncodingSelector.encoding_str='seq-only'
input_to_methyl_rep/methylseqnet.transforms.EncodingSelector.encoding_str='interp-methyl-only'

input_to_methyl_rep/AvgPool1d.kernel_size=32
input_to_methyl_rep/Hardtanh.min_val=0.0
input_to_methyl_rep/Hardtanh.max_val=1.0

integrate_methyl/methylseqnet.layers.ConvBlock.in_channels=1921
integrate_methyl/methylseqnet.layers.ConvBlock.filters=%initial_filters
integrate_methyl/methylseqnet.layers.ConvBlock.kernel_size=1
integrate_methyl/methylseqnet.layers.ConvBlock.pool_size=4

methylseqnet.layers.DilatedResidual.in_channels=%initial_filters
methylseqnet.layers.DilatedResidual.filters=%dilated_residual_filters 
methylseqnet.layers.DilatedResidual.kernel_size=3
methylseqnet.layers.DilatedResidual.rate_mult=2
methylseqnet.layers.DilatedResidual.repeat=7
methylseqnet.layers.DilatedResidual.dropout=0.3

scaleup_block/methylseqnet.layers.ConvFinal.in_channels=%dilated_residual_filters
scaleup_block/methylseqnet.layers.ConvFinal.filters=1024
scaleup_block/methylseqnet.layers.ConvFinal.kernel_size=1

methylseq_model/methylseqnet.layers.ConvFinal.in_channels=100
methylseq_model/methylseqnet.layers.ConvFinal.shared_head=False
methylseq_model/methylseqnet.layers.ConvFinal.filters=1024

embeddings_to_unconditional_seq_rep/methylseqnet.layers.ConvBlock.in_channels=1920
embeddings_to_unconditional_seq_rep/methylseqnet.layers.ConvBlock.filters=1024
embeddings_to_unconditional_seq_rep/methylseqnet.layers.ConvBlock.kernel_size=1
embeddings_to_unconditional_seq_rep/methylseqnet.layers.ConvBlock.pool_size=4
embeddings_to_unconditional_seq_rep/methylseqnet.layers.ConvBlock.pool_class=@MaxPool1d

embeddings_to_conditional_seq_rep/methylseqnet.layers.ConvBlock.in_channels=1920
embeddings_to_conditional_seq_rep/methylseqnet.layers.ConvBlock.filters=1024
embeddings_to_conditional_seq_rep/methylseqnet.layers.ConvBlock.kernel_size=1
embeddings_to_conditional_seq_rep/methylseqnet.layers.ConvBlock.pool_size=4
embeddings_to_conditional_seq_rep/methylseqnet.layers.ConvBlock.pool_class=@MaxPool1d

methyl_reps_probe/Conv1d.in_channels=1024
methyl_reps_probe/Conv1d.out_channels=42
methyl_reps_probe/Conv1d.kernel_size=1

embeddings_to_methyl_rep/methylseqnet.layers.ConvFinal.in_channels=1920
embeddings_to_methyl_rep/methylseqnet.layers.ConvFinal.filters=1024
embeddings_to_methyl_rep/methylseqnet.layers.ConvFinal.kernel_size=1
embeddings_to_methyl_rep/methylseqnet.layers.ConvFinal.pool_size=4
embeddings_to_methyl_rep/methylseqnet.layers.ConvFinal.pool_class=@AvgPool1d

factorized_reps_to_output/methylseqnet.layers.ConvFinal.in_channels=2048
factorized_reps_to_output/methylseqnet.layers.ConvFinal.filters=1
factorized_reps_to_output/methylseqnet.layers.ConvFinal.kernel_size=1

methylseqnet.optimizers.AdamOptimizer.lr=0.002
methylseqnet.optimizers.AdamOptimizer.betas=(0.9,0.999)

methylseqnet.methylseqnn.MethylSeqNN.layers = None
methylseqnet.methylseqnn.MethylSeqNN.pretrained_seq_model_generator = @borzoi_pytorch
methylseqnet.methylseqnn.MethylSeqNN.pretrained_seq_model_weights = 'johahi/borzoi-replicate-0'
methylseqnet.methylseqnn.MethylSeqNN.seq_input_head = [@seq_model/EncodingSelector]
methylseqnet.methylseqnn.MethylSeqNN.seq_output_head = None
methylseqnet.methylseqnn.MethylSeqNN.merged_output_head = []
methylseqnet.methylseqnn.MethylSeqNN.model_merge_operation = 'multiply'
methylseqnet.methylseqnn.MethylSeqNN.embeddings_to_methyl_rep = [@Softplus]
methylseqnet.methylseqnn.MethylSeqNN.embeddings_to_unconditional_seq_rep = [
    @embeddings_to_unconditional_seq_rep/ConvBlock,
]
methylseqnet.methylseqnn.MethylSeqNN.embeddings_to_conditional_seq_rep = [
    @embeddings_to_conditional_seq_rep/ConvBlock,
]
methylseqnet.methylseqnn.MethylSeqNN.input_to_methyl_rep = [
    @input_to_methyl_rep/EncodingSelector,
    @input_to_methyl_rep/AvgPool1d,
    @input_to_methyl_rep/Hardtanh,
    @integrate_methyl/ConvBlock,
    @DilatedResidual,
    @scaleup_block/ConvFinal,
]
methylseqnet.methylseqnn.MethylSeqNN.unconditional_seq_rep_probe=[]
methylseqnet.methylseqnn.MethylSeqNN.conditional_seq_rep_probe=[]
methylseqnet.methylseqnn.MethylSeqNN.factorized_reps_to_output = [
    @factorized_reps_to_output/ConvFinal,
    @Softplus,
]
methylseqnet.methylseqnn.MethylSeqNN.true_conditioning_state_rep_weight=1.0
methylseqnet.methylseqnn.MethylSeqNN.train_stages={
            'train-factorized-pretrained-embeddings':{
                'mode':'factorized-from-pretrained',
                'grad_dict':{
                    'layers':False,
                    'pretrained_seq_model':False,
                    'seq_input_head':False,
                    'seq_output_head':True,
                    'input_to_methyl_rep':True,
                    'embeddings_to_methyl_rep':True,
                    'embeddings_to_unconditional_seq_rep':True,
                    'embeddings_to_conditional_seq_rep':True,
                    'factorized_reps_to_output':True,
                },
                'epochs':30,
            },
        }
methylseqnet.methylseqnn.MethylSeqNN.out_tracks=63
methylseqnet.methylseqnn.MethylSeqNN.regression=True
methylseqnet.methylseqnn.MethylSeqNN.pad_all_layers=True
methylseqnet.methylseqnn.MethylSeqNN.crop_off_final=64
methylseqnet.methylseqnn.MethylSeqNN.crop_off_sequence=155648
methylseqnet.methylseqnn.MethylSeqNN.concat_pretrained_embeddings_at={
    -3:1,
}
methylseqnet.methylseqnn.MethylSeqNN.residual_activation_loss_weight=0
methylseqnet.methylseqnn.MethylSeqNN.activation_criterion=@LogL2Loss
methylseqnet.methylseqnn.MethylSeqNN.methyl_rep_loss_weight=0.0
methylseqnet.methylseqnn.MethylSeqNN.methyl_rep_criterion=@MSELoss
methylseqnet.methylseqnn.MethylSeqNN.seq_reps_orthogonality_loss_weight=0.0

methylseqnet.trainer.MethylSeqDataModule.train_dataset_file="/global/scratch/users/dixonluinenburg/atlas_datasets/borzoi-128lzf-multimethyl-bisulfite-atac-cage/fold0.h5"
methylseqnet.trainer.MethylSeqDataModule.validation_dataset_file="/global/scratch/users/dixonluinenburg/atlas_datasets/borzoi-128lzf-multimethyl-bisulfite-atac-cage/fold1.h5"
methylseqnet.trainer.MethylSeqDataModule.batch_size=1
methylseqnet.trainer.MethylSeqDataModule.transforms=(@ReverseComplement,@SequenceJitter)
methylseqnet.trainer.MethylSeqDataModule.dataset_class=@MultiMethylDataset

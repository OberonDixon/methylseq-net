initial_filters = 512
dilated_residual_filters = 512
embedding_dim = 1920
embedding_pool = 1
predictions_pool = 4

methylseqnet.transforms.ReverseComplement.probability=0.5
methylseqnet.transforms.ReverseComplement.batch_wise=False

methylseqnet.transforms.SequenceJitter.stdev=1
methylseqnet.transforms.SequenceJitter.max_jitter=3
methylseqnet.transforms.SequenceJitter.batch_wise=False

seq_model/methylseqnet.transforms.EncodingSelector.encoding_str='seq-only'
input_to_methyl_rep/methylseqnet.transforms.EncodingSelector.encoding_str='interp-methyl-only'

input_to_methyl_rep/AvgPool1d.kernel_size=32
input_to_methyl_rep/Hardtanh.min_val=0.0
input_to_methyl_rep/Hardtanh.max_val=1.0

integrate_embs/methylseqnet.layers.ConvBlock.in_channels=2048
integrate_embs/methylseqnet.layers.ConvBlock.filters=%initial_filters
integrate_embs/methylseqnet.layers.ConvBlock.kernel_size=1
integrate_embs/methylseqnet.layers.ConvBlock.pool_size=1

methylseqnet.layers.DilatedResidual.in_channels=%initial_filters
methylseqnet.layers.DilatedResidual.filters=%dilated_residual_filters 
methylseqnet.layers.DilatedResidual.kernel_size=3
methylseqnet.layers.DilatedResidual.rate_mult=2
methylseqnet.layers.DilatedResidual.repeat=5
methylseqnet.layers.DilatedResidual.dropout=0.3

scaleup_block/methylseqnet.layers.ConvFinal.in_channels=%dilated_residual_filters
scaleup_block/methylseqnet.layers.ConvFinal.filters=63
scaleup_block/methylseqnet.layers.ConvFinal.kernel_size=1
scaleup_block/methylseqnet.layers.ConvFinal.pool_size=%predictions_pool
scaleup_block/methylseqnet.layers.ConvFinal.pool_class=@AvgPool1d

embeddings_to_unconditional_seq_rep/methylseqnet.layers.ConvBlock.in_channels=%embedding_dim
embeddings_to_unconditional_seq_rep/methylseqnet.layers.ConvBlock.filters=1024
embeddings_to_unconditional_seq_rep/methylseqnet.layers.ConvBlock.kernel_size=1
embeddings_to_unconditional_seq_rep/methylseqnet.layers.ConvBlock.pool_size=%embedding_pool
embeddings_to_unconditional_seq_rep/methylseqnet.layers.ConvBlock.pool_class=@AvgPool1d

embeddings_to_conditional_seq_rep/methylseqnet.layers.ConvBlock.in_channels=%embedding_dim
embeddings_to_conditional_seq_rep/methylseqnet.layers.ConvBlock.filters=1024
embeddings_to_conditional_seq_rep/methylseqnet.layers.ConvBlock.kernel_size=1
embeddings_to_conditional_seq_rep/methylseqnet.layers.ConvBlock.pool_size=%embedding_pool
embeddings_to_conditional_seq_rep/methylseqnet.layers.ConvBlock.pool_class=@AvgPool1d

methyl_reps_probe/Conv1d.in_channels=1024
methyl_reps_probe/Conv1d.out_channels=42
methyl_reps_probe/Conv1d.kernel_size=1

embeddings_to_methyl_rep/methylseqnet.layers.ConvFinal.in_channels=%embedding_dim
embeddings_to_methyl_rep/methylseqnet.layers.ConvFinal.filters=42
embeddings_to_methyl_rep/methylseqnet.layers.ConvFinal.kernel_size=1
embeddings_to_methyl_rep/methylseqnet.layers.ConvFinal.pool_size=%embedding_pool
embeddings_to_methyl_rep/methylseqnet.layers.ConvFinal.pool_class=@AvgPool1d

torch.optim.Adam.lr=0.002
torch.optim.Adam.betas=(0.9,0.999)

methylseqnet.pretrained.borzoi_pytorch.remove_crop=False
methylseqnet.pretrained.borzoi_pytorch.reinitialize=False

methylseqnet.model.ConditionedSeqNN.layers = None
methylseqnet.model.ConditionedSeqNN.pretrained_seq_model_generator = @borzoi_pytorch
methylseqnet.model.ConditionedSeqNN.pretrained_seq_model_weights = 'johahi/borzoi-replicate-0'
#'johahi/borzoi-replicate-0'
methylseqnet.model.ConditionedSeqNN.seq_input_head = [@seq_model/EncodingSelector]
methylseqnet.model.ConditionedSeqNN.seq_output_head = None
methylseqnet.model.ConditionedSeqNN.merged_output_head = []
methylseqnet.model.ConditionedSeqNN.model_merge_operation = 'multiply'
methylseqnet.model.ConditionedSeqNN.embeddings_to_methyl_rep = [
    @embeddings_to_methyl_rep/ConvFinal,
    @Sigmoid,
]
methylseqnet.model.ConditionedSeqNN.embeddings_to_unconditional_seq_rep = [
    @embeddings_to_unconditional_seq_rep/ConvBlock,
]
methylseqnet.model.ConditionedSeqNN.embeddings_to_conditional_seq_rep = [
    @embeddings_to_conditional_seq_rep/ConvBlock,
]
methylseqnet.model.ConditionedSeqNN.input_to_methyl_rep = [
    @input_to_methyl_rep/EncodingSelector,
    @input_to_methyl_rep/AvgPool1d,
    @input_to_methyl_rep/Hardtanh,
]
methylseqnet.model.ConditionedSeqNN.unconditional_seq_rep_probe=[]
methylseqnet.model.ConditionedSeqNN.conditional_seq_rep_probe=[]
methylseqnet.model.ConditionedSeqNN.factorized_reps_to_output = [
    @integrate_embs/ConvBlock,
    @DilatedResidual,
    @scaleup_block/ConvFinal,
    @Softplus,
]
methylseqnet.model.ConditionedSeqNN.factorized_reps_to_output_submodel_per_task=False
methylseqnet.model.ConditionedSeqNN.factorized_reps_to_output_submodels_shared=False
methylseqnet.model.ConditionedSeqNN.true_conditioning_state_rep_weight=1.0
methylseqnet.model.ConditionedSeqNN.train_stages={
            'train-factorized-pretrained-embeddings':{
                'mode':'factorized-from-pretrained',
                'grad_dict':{
                    'layers':False,
                    'pretrained_seq_model':False,
                    'seq_input_head':False,
                    'seq_output_head':True,
                    'input_to_methyl_rep':True,
                    'embeddings_to_methyl_rep':True,
                    'embeddings_to_unconditional_seq_rep':True,
                    'embeddings_to_conditional_seq_rep':True,
                    'factorized_reps_to_output':True,
                },
                'epochs':100,
            },
        }
methylseqnet.model.ConditionedSeqNN.out_tracks=63
methylseqnet.model.ConditionedSeqNN.regression=True
methylseqnet.model.ConditionedSeqNN.pad_all_layers=True
methylseqnet.model.ConditionedSeqNN.crop_off_final=0
methylseqnet.model.ConditionedSeqNN.crop_off_sequence=163840
methylseqnet.model.ConditionedSeqNN.concat_pretrained_embeddings_at={}
methylseqnet.model.ConditionedSeqNN.residual_activation_loss_weight=0
methylseqnet.model.ConditionedSeqNN.activation_criterion=@LogL2Loss
methylseqnet.model.ConditionedSeqNN.methyl_rep_loss_weight=1.0
methylseqnet.model.ConditionedSeqNN.seq_reps_orthogonality_loss_weight=0.0

methylseqnet.callbacks.HaplotypedPredLogger.accessibility_outputs_slice=[0]
methylseqnet.callbacks.HaplotypedPredLogger.rna_outputs_slice=[1]

methylseqnet.trainer.MethylSeqDataModule.train_dataset_file={
    "atlas":[
        "/mnt/faststorage/oberon/atlas_datasets/borzoi-softclipped-multimethyl-bisulfite-atac-cage/fold1.h5",
        "/mnt/faststorage/oberon/atlas_datasets/borzoi-softclipped-multimethyl-bisulfite-atac-cage/fold2.h5",
        "/mnt/faststorage/oberon/atlas_datasets/borzoi-softclipped-multimethyl-bisulfite-atac-cage/fold5.h5",
        "/mnt/faststorage/oberon/atlas_datasets/borzoi-softclipped-multimethyl-bisulfite-atac-cage/fold6.h5",
        "/mnt/faststorage/oberon/atlas_datasets/borzoi-softclipped-multimethyl-bisulfite-atac-cage/fold7.h5",
    ],
}
methylseqnet.trainer.MethylSeqDataModule.validation_dataset_file={
    "atlas":["/mnt/faststorage/oberon/atlas_datasets/borzoi-softclipped-multimethyl-bisulfite-atac-cage/fold4.h5",],
}
methylseqnet.trainer.MethylSeqDataModule.batch_size=1
methylseqnet.trainer.MethylSeqDataModule.transforms=(@ReverseComplement,@SequenceJitter)
methylseqnet.trainer.MethylSeqDataModule.dataset_class=@MultiMethylDataset
methylseqnet.trainer.MethylSeqDataModule.epoch_size=2500
methylseqnet.trainer.MethylSeqDataModule.val_epoch_size=(1000,)

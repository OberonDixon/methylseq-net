methylseqnet.transforms.ReverseComplement.probability=0.5
methylseqnet.transforms.ReverseComplement.batch_wise=False

methylseqnet.transforms.SequenceJitter.stdev=1
methylseqnet.transforms.SequenceJitter.max_jitter=3
methylseqnet.transforms.SequenceJitter.batch_wise=False

methylseqnet.layers.EncodingAdjuster.encoding_str='seq-only'

methylseqnet.layers.ConvDNA.filters=63
methylseqnet.layers.ConvDNA.kernel_size=55001
methylseqnet.layers.ConvDNA.pool_size=1
methylseqnet.layers.ConvDNA.stride=128
methylseqnet.layers.ConvDNA.in_channels=4
methylseqnet.layers.ConvDNA.weight_decay=0

methylseqnet.model.ConditionedSeqNN.layers = [@EncodingAdjuster,@ConvDNA]
methylseqnet.model.ConditionedSeqNN.out_tracks=63
methylseqnet.model.ConditionedSeqNN.regression=True
methylseqnet.model.ConditionedSeqNN.pad_all_layers=True
methylseqnet.model.ConditionedSeqNN.crop_off_final=64
methylseqnet.model.ConditionedSeqNN.label_threshold_cts=0.5
methylseqnet.model.ConditionedSeqNN.learning_rate=0.002

methylseqnet.trainer.MethylSeqDataModule.train_dataset_file="/global/scratch/users/dixonluinenburg/atlas_datasets/bisulfite-atac-cage/train.h5"
methylseqnet.trainer.MethylSeqDataModule.validation_dataset_file="/global/scratch/users/dixonluinenburg/atlas_datasets/bisulfite-atac-cage/valid.h5"
methylseqnet.trainer.MethylSeqDataModule.batch_size=16
methylseqnet.trainer.MethylSeqDataModule.transforms=[@ReverseComplement,@SequenceJitter]

initial_filters = 288
tower_end_filters = 508
dilated_residual_filters = 384

dna_split_ranges = ((0,4),(4,7))
dna_split = (0.57143,0.42857)
filters_split = (0.7,0.3)

methylseqnet.transforms.ReverseComplement.probability=0.5
methylseqnet.transforms.ReverseComplement.batch_wise=False

methylseqnet.transforms.SequenceJitter.stdev=10
methylseqnet.transforms.SequenceJitter.max_jitter=32
methylseqnet.transforms.SequenceJitter.batch_wise=False

methylseqnet.layers.EncodingAdjuster.encoding_str='seq+methyl_binary-seq'

methylseqnet.layers.ChannelSplitter.split_ranges=%dna_split_ranges

methylseqnet.layers.SplitConvDNA.filters=%initial_filters
methylseqnet.layers.SplitConvDNA.kernel_size=15
methylseqnet.layers.SplitConvDNA.pool_size=2
methylseqnet.layers.SplitConvDNA.in_channels=7
methylseqnet.layers.SplitConvDNA.weight_decay=0
methylseqnet.layers.SplitConvDNA.input_splits=%dna_split
methylseqnet.layers.SplitConvDNA.output_splits=%filters_split

methylseqnet.layers.SplitConvTower.in_channels=%initial_filters
methylseqnet.layers.SplitConvTower.filters_init=%initial_filters
methylseqnet.layers.SplitConvTower.filters_end=%tower_end_filters
methylseqnet.layers.SplitConvTower.divisible_by=16
methylseqnet.layers.SplitConvTower.kernel_size=5
methylseqnet.layers.SplitConvTower.pool_size=2
methylseqnet.layers.SplitConvTower.repeat=6
methylseqnet.layers.SplitConvTower.input_splits=%filters_split
methylseqnet.layers.SplitConvTower.output_splits=%filters_split

methylseqnet.layers.SplitDilatedResidual.in_channels=%tower_end_filters
methylseqnet.layers.SplitDilatedResidual.filters=%dilated_residual_filters 
methylseqnet.layers.SplitDilatedResidual.kernel_size=3
methylseqnet.layers.SplitDilatedResidual.rate_mult=1.5 
methylseqnet.layers.SplitDilatedResidual.repeat=11
methylseqnet.layers.SplitDilatedResidual.dropout=0.3
methylseqnet.layers.SplitDilatedResidual.input_splits=%filters_split
methylseqnet.layers.SplitDilatedResidual.output_splits=%filters_split

methylseqnet.layers.SplitConvBlock.in_channels=%tower_end_filters
methylseqnet.layers.SplitConvBlock.filters=1536
methylseqnet.layers.SplitConvBlock.kernel_size=5
methylseqnet.layers.SplitConvBlock.dilation=1
methylseqnet.layers.SplitConvBlock.input_splits=%filters_split
methylseqnet.layers.SplitConvBlock.output_splits=%filters_split

methylseqnet.layers.SplitConvFinal.in_channels=1536
methylseqnet.layers.SplitConvFinal.shared_head=False
methylseqnet.layers.SplitConvFinal.filters=126
methylseqnet.layers.SplitConvFinal.input_splits=%filters_split
methylseqnet.layers.SplitConvFinal.output_splits=(0.5,0.5)

methylseqnet.layers.LearnedWeightedSum.num_tensors=2

methylseqnet.model.ConditionedSeqNN.layers = [@EncodingAdjuster,@ChannelSplitter,@SplitConvDNA,@SplitConvTower,@SplitDilatedResidual,@SplitConvBlock,@SplitConvFinal,@LearnedWeightedSum]
methylseqnet.model.ConditionedSeqNN.out_tracks=63
methylseqnet.model.ConditionedSeqNN.regression=True
methylseqnet.model.ConditionedSeqNN.pad_all_layers=True
methylseqnet.model.ConditionedSeqNN.crop_off_final=64
methylseqnet.model.ConditionedSeqNN.label_threshold_cts=0.5
methylseqnet.model.ConditionedSeqNN.learning_rate=0.002

methylseqnet.datamodule.MethylSeqDataModule.train_dataset_file="/global/scratch/users/dixonluinenburg/atlas_datasets/bisulfite-atac-cage/train.h5"
methylseqnet.datamodule.MethylSeqDataModule.validation_dataset_file="/global/scratch/users/dixonluinenburg/atlas_datasets/bisulfite-atac-cage/valid.h5"
methylseqnet.datamodule.MethylSeqDataModule.batch_size=16
methylseqnet.datamodule.MethylSeqDataModule.transforms=[@ReverseComplement,@SequenceJitter]

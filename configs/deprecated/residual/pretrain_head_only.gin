initial_filters = 288
tower_end_filters = 508
dilated_residual_filters = 384

methylseqnet.transforms.ReverseComplement.probability=0.5
methylseqnet.transforms.ReverseComplement.batch_wise=False

methylseqnet.transforms.SequenceJitter.stdev=1
methylseqnet.transforms.SequenceJitter.max_jitter=3
methylseqnet.transforms.SequenceJitter.batch_wise=False

seq_model/methylseqnet.layers.EncodingAdjuster.encoding_str='seq-only'

methylseqnet.layers.ConvFinal.in_channels=1536
methylseqnet.layers.ConvFinal.shared_head=False
methylseqnet.layers.ConvFinal.filters=63

methylseqnet.model.ConditionedSeqNN.layers = [] 
methylseqnet.model.ConditionedSeqNN.pretrained_seq_model_generator = @basenji2_pytorch
methylseqnet.model.ConditionedSeqNN.pretrained_seq_model_weights = '/clusterfs/nilah/oberon/repos/basenji2-pytorch/data/basenji2.pth'
methylseqnet.model.ConditionedSeqNN.seq_input_head = [@seq_model/EncodingAdjuster]
methylseqnet.model.ConditionedSeqNN.seq_output_head = [@ConvFinal,@Softplus]
methylseqnet.model.ConditionedSeqNN.out_tracks=63
methylseqnet.model.ConditionedSeqNN.regression=True
methylseqnet.model.ConditionedSeqNN.pad_all_layers=True
methylseqnet.model.ConditionedSeqNN.crop_off_final=64
methylseqnet.model.ConditionedSeqNN.label_threshold_cts=0.5
methylseqnet.model.ConditionedSeqNN.learning_rate=0.002

methylseqnet.datamodule.MethylSeqDataModule.train_dataset_file="/global/scratch/users/dixonluinenburg/atlas_datasets/multimethyl-bisulfite-atac-cage/test.h5"
methylseqnet.datamodule.MethylSeqDataModule.validation_dataset_file="/global/scratch/users/dixonluinenburg/atlas_datasets/multimethyl-bisulfite-atac-cage/valid.h5"
methylseqnet.datamodule.MethylSeqDataModule.batch_size=32
methylseqnet.datamodule.MethylSeqDataModule.transforms=[@ReverseComplement,@SequenceJitter]
methylseqnet.datamodule.MethylSeqDataModule.dataset_class=@MultiMethylDataset

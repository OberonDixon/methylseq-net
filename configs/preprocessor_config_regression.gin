ref_genome = '/clusterfs/nilah/oberon/genomes/hg38.fa'
regions_bed = '/clusterfs/nilah/oberon/datasets/basenji2_human_training/sequences.bed'
methylation_directory = '/global/scratch/users/dixonluinenburg/methylation_atlas/GSE186458_RAW'
atac_directory = '/global/scratch/users/dixonluinenburg/atac_atlas/bigwigs'
match_file = '/clusterfs/nilah/oberon/genomic-data-exploration/cell_atlases/cell_type_matching.txt'
output_directory = '/global/scratch/users/dixonluinenburg/atlas_datasets/bisulfite-atac/'
label_bin_size = 128
label_num_bins = 1024
seq_length = 131072

DatasetWriter.track_length = %label_num_bins
DatasetWriter.seq_length = %seq_length
DatasetWriter.cpg_input = True
DatasetWriter.mask = True

RegionBedParser.regions_bed = %regions_bed

MethylAtacAtlases.ref_genome = %ref_genome
MethylAtacAtlases.methylation_directory = %methylation_directory
MethylAtacAtlases.targets_directory = %atac_directory
MethylAtacAtlases.match_file = %match_file
MethylAtacAtlases.label_bin_size = %label_bin_size
MethylAtacAtlases.label_num_bins = %label_num_bins
MethylAtacAtlases.normalize_label_counts = False
MethylAtacAtlases.normalize_label_gc = False
MethylAtacAtlases.binarize_labels = False

PreprocessingPipeline.sample_generator = @RegionBedParser()
PreprocessingPipeline.multitask_io_handler = @MethylAtacAtlases()
PreprocessingPipeline.dataset_writer_class = @DatasetWriter
PreprocessingPipeline.output_directory = %output_directory



initial_filters = 30
tower_end_filters = 40
penultimate_filters = 40
embedding_pool = 4
model_tasks = 65
cell_types = 43

methylseqnet.transforms.ReverseComplement.probability=0.5
methylseqnet.transforms.ReverseComplement.batch_wise=False

methylseqnet.transforms.SequenceJitter.stdev=1
methylseqnet.transforms.SequenceJitter.max_jitter=3
methylseqnet.transforms.SequenceJitter.batch_wise=False

methylseq_model/methylseqnet.transforms.EncodingSelector.encoding_str='seq+interp-methyl+cpg-density'

input_to_methyl_rep/AvgPool1d.kernel_size=128

methylseqnet.layers.ConvDNA.filters=%initial_filters
methylseqnet.layers.ConvDNA.kernel_size=17
methylseqnet.layers.ConvDNA.pool_size=2
methylseqnet.layers.ConvDNA.in_channels=7

methylseqnet.layers.ConvTower.in_channels=%initial_filters
methylseqnet.layers.ConvTower.filters_init=%initial_filters
methylseqnet.layers.ConvTower.filters_end=%tower_end_filters
methylseqnet.layers.ConvTower.divisible_by=16
methylseqnet.layers.ConvTower.kernel_size=5
methylseqnet.layers.ConvTower.pool_size=2
methylseqnet.layers.ConvTower.repeat=6

methylseqnet.layers.ConvBlock.in_channels=%tower_end_filters
methylseqnet.layers.ConvBlock.filters=%penultimate_filters
methylseqnet.layers.ConvBlock.kernel_size=1

methylseqnet.layers.ConvDropout.in_channels=%penultimate_filters
methylseqnet.layers.ConvDropout.filters=768
methylseqnet.layers.ConvDropout.kernel_size=5
methylseqnet.layers.ConvDropout.dropout=0.2

methylseqnet.layers.ConvFinal.in_channels=768
methylseqnet.layers.ConvFinal.shared_head=False
methylseqnet.layers.ConvFinal.filters=%model_tasks

torch.optim.Adam.lr=0.002
torch.optim.Adam.betas=(0.9,0.999)

methylseqnet.model.ConditionedSeqNN.sequence_encoder = [@input_to_methyl_rep/AvgPool1d]
methylseqnet.model.ConditionedSeqNN.conditioning_operation = 'keep_modulator'
methylseqnet.model.ConditionedSeqNN.embeddings_to_conditioning_state_rep = []
methylseqnet.model.ConditionedSeqNN.embeddings_to_unconditional_seq_rep = [@ZeroChannels]
methylseqnet.model.ConditionedSeqNN.embeddings_to_conditional_seq_rep = []
methylseqnet.model.ConditionedSeqNN.conditioning_state_encoder = [
    @methylseq_model/EncodingSelector,
    @ConvDNA,
    @ConvTower,
    @ConvBlock,
    @ConvDropout,
    @ConvFinal,
    @Softplus,
]
methylseqnet.model.ConditionedSeqNN.output_head = []
methylseqnet.model.ConditionedSeqNN.true_conditioning_state_weight=1.0
methylseqnet.model.ConditionedSeqNN.out_tracks=%model_tasks
methylseqnet.model.ConditionedSeqNN.regression=True
methylseqnet.model.ConditionedSeqNN.crop_off_output=0
methylseqnet.model.ConditionedSeqNN.crop_off_conditioning_input=163840
methylseqnet.model.ConditionedSeqNN.concat_pretrained_embeddings_at={}
methylseqnet.model.ConditionedSeqNN.conditioning_state_rep_loss_weight=0.0
methylseqnet.model.ConditionedSeqNN.seq_reps_orthogonality_loss_weight=0.0

methylseqnet.callbacks.HaplotypedPredLogger.accessibility_outputs_slice=[0]
methylseqnet.callbacks.HaplotypedPredLogger.rna_outputs_slice=[1]

methylseqnet.datamodule.MethylSeqDataModule.train_dataset_file={
    "atlas":[
        "/global/scratch/projects/vector_streetslab/oberon/methylseqnet_manuscript_datasets/atlas/fold0.h5",
        "/global/scratch/projects/vector_streetslab/oberon/methylseqnet_manuscript_datasets/atlas/fold1.h5",
        "/global/scratch/projects/vector_streetslab/oberon/methylseqnet_manuscript_datasets/atlas/fold2.h5",
        "/global/scratch/projects/vector_streetslab/oberon/methylseqnet_manuscript_datasets/atlas/fold5.h5",
        "/global/scratch/projects/vector_streetslab/oberon/methylseqnet_manuscript_datasets/atlas/fold6.h5",
        "/global/scratch/projects/vector_streetslab/oberon/methylseqnet_manuscript_datasets/atlas/fold7.h5",
    ],
    "longread":[
        "/global/scratch/projects/vector_streetslab/oberon/methylseqnet_manuscript_datasets/gm12878/fold0.h5",
        "/global/scratch/projects/vector_streetslab/oberon/methylseqnet_manuscript_datasets/gm12878/fold1.h5",
        "/global/scratch/projects/vector_streetslab/oberon/methylseqnet_manuscript_datasets/gm12878/fold2.h5",
        "/global/scratch/projects/vector_streetslab/oberon/methylseqnet_manuscript_datasets/gm12878/fold5.h5",
        "/global/scratch/projects/vector_streetslab/oberon/methylseqnet_manuscript_datasets/gm12878/fold6.h5",
        "/global/scratch/projects/vector_streetslab/oberon/methylseqnet_manuscript_datasets/gm12878/fold7.h5",
        "/global/scratch/projects/vector_streetslab/oberon/methylseqnet_manuscript_datasets/gm12878_chrX/fold0.h5",
        "/global/scratch/projects/vector_streetslab/oberon/methylseqnet_manuscript_datasets/gm12878_chrX/fold1.h5",
        "/global/scratch/projects/vector_streetslab/oberon/methylseqnet_manuscript_datasets/gm12878_chrX/fold2.h5",
        "/global/scratch/projects/vector_streetslab/oberon/methylseqnet_manuscript_datasets/gm12878_chrX/fold5.h5",
        "/global/scratch/projects/vector_streetslab/oberon/methylseqnet_manuscript_datasets/gm12878_chrX/fold6.h5",
        "/global/scratch/projects/vector_streetslab/oberon/methylseqnet_manuscript_datasets/gm12878_chrX/fold7.h5",
    ]
}
methylseqnet.datamodule.MethylSeqDataModule.validation_dataset_file={
    "atlas":[
        "/global/scratch/projects/vector_streetslab/oberon/methylseqnet_manuscript_datasets/atlas/fold4.h5",
    ],
    "longread":[
        "/global/scratch/projects/vector_streetslab/oberon/methylseqnet_manuscript_datasets/gm12878/fold4.h5"
    ],
}
methylseqnet.datamodule.MethylSeqDataModule.batch_size=1
methylseqnet.datamodule.MethylSeqDataModule.transforms=(@ReverseComplement,@SequenceJitter)
methylseqnet.datamodule.MethylSeqDataModule.dataset_class=@MultiMethylDataset
methylseqnet.datamodule.MethylSeqDataModule.epoch_size=10000
methylseqnet.datamodule.MethylSeqDataModule.val_epoch_size=None

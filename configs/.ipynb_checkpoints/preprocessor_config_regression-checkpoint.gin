ref_genome = '/clusterfs/nilah/oberon/genomes/hg38.fa'
regions_bed = '/clusterfs/nilah/oberon/datasets/basenji2_human_training/sequences.bed'
methylation_directory = '/global/scratch/users/dixonluinenburg/methylation_atlas/GSE186458_RAW'
atac_directory = '/global/scratch/users/dixonluinenburg/atac_atlas/bigwigs'
match_file = '/clusterfs/nilah/oberon/genomic-data-exploration/cell_atlases/cell_type_matching.txt'
output_directory = '/global/scratch/users/dixonluinenburg/atlas_datasets/regression_new_pipeline/'
label_bin_size = 128
label_num_bins = 1024
# trim_off_ends = 0
seq_length = 131072

DatasetWriter.track_length = %label_num_bins
DatasetWriter.seq_length = %seq_length
DatasetWriter.cpg_input = True
DatasetWriter.mask = True

RegionBedParser.regions_bed = %regions_bed

BigWigCellAtlas.ref_genome = %ref_genome
BigWigCellAtlas.methylation_directory = %methylation_directory
BigWigCellAtlas.targets_directory = %atac_directory
BigWigCellAtlas.match_file = %match_file
BigWigCellAtlas.max_chunks_in_mem = 1000
# BigWigCellAtlas.trim_off_ends = %trim_off_ends
BigWigCellAtlas.label_bin_size = %label_bin_size
BigWigCellAtlas.label_num_bins = %label_num_bins
BigWigCellAtlas.normalize_label_counts = False
BigWigCellAtlas.normalize_label_gc = True
BigWigCellAtlas.binarize_labels = False
# BigWigCellAtlas.threshold_labels = 5

PreprocessingPipeline.sample_generator = @RegionBedParser()
PreprocessingPipeline.multitask_io_handler = @BigWigCellAtlas()
PreprocessingPipeline.dataset_writer_class = @DatasetWriter
PreprocessingPipeline.samples_per_batch = 1
PreprocessingPipeline.output_directory = %output_directory



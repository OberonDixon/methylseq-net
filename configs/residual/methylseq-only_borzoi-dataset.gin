initial_filters = 30
tower_end_filters = 40
dilated_residual_filters = 40

methylseqnet.transforms.ReverseComplement.probability=0.5
methylseqnet.transforms.ReverseComplement.batch_wise=False

methylseqnet.transforms.SequenceJitter.stdev=1
methylseqnet.transforms.SequenceJitter.max_jitter=3
methylseqnet.transforms.SequenceJitter.batch_wise=False

seq_model/methylseqnet.layers.EncodingAdjuster.encoding_str='seq-only'
methylseq_model/methylseqnet.layers.EncodingAdjuster.encoding_str='seq+methyl_binary-seq'

methylseqnet.layers.ConvDNA.filters=%initial_filters
methylseqnet.layers.ConvDNA.kernel_size=15
methylseqnet.layers.ConvDNA.pool_size=2
methylseqnet.layers.ConvDNA.in_channels=7
methylseqnet.layers.ConvDNA.weight_decay=0

methylseqnet.layers.ConvTower.in_channels=%initial_filters
methylseqnet.layers.ConvTower.filters_init=%initial_filters
methylseqnet.layers.ConvTower.filters_end=%tower_end_filters
methylseqnet.layers.ConvTower.divisible_by=16
methylseqnet.layers.ConvTower.kernel_size=5
methylseqnet.layers.ConvTower.pool_size=2
methylseqnet.layers.ConvTower.repeat=6

methylseqnet.layers.DilatedResidual.in_channels=%tower_end_filters
methylseqnet.layers.DilatedResidual.filters=%dilated_residual_filters 
methylseqnet.layers.DilatedResidual.kernel_size=3
methylseqnet.layers.DilatedResidual.rate_mult=1.5 
methylseqnet.layers.DilatedResidual.repeat=11
methylseqnet.layers.DilatedResidual.dropout=0.3

methylseqnet.layers.ConvBlock.in_channels=%tower_end_filters
methylseqnet.layers.ConvBlock.filters=1536
methylseqnet.layers.ConvBlock.kernel_size=5
methylseqnet.layers.ConvBlock.dilation=1

seq_model/methylseqnet.layers.ConvFinal.in_channels=1920
seq_model/methylseqnet.layers.ConvFinal.shared_head=False
seq_model/methylseqnet.layers.ConvFinal.filters=63
seq_model/methylseqnet.layers.ConvFinal.pool_size=4

methylseq_model/methylseqnet.layers.ConvFinal.in_channels=1536
methylseq_model/methylseqnet.layers.ConvFinal.shared_head=False
methylseq_model/methylseqnet.layers.ConvFinal.filters=63

methylseqnet.methylseqnn.MethylSeqNN.layers = [@methylseq_model/EncodingAdjuster,@ConvDNA,@ConvTower,@DilatedResidual,@ConvBlock,@methylseq_model/ConvFinal,@Softplus]
methylseqnet.methylseqnn.MethylSeqNN.pretrained_seq_model_generator = None
methylseqnet.methylseqnn.MethylSeqNN.pretrained_seq_model_weights = None
methylseqnet.methylseqnn.MethylSeqNN.seq_input_head = []
methylseqnet.methylseqnn.MethylSeqNN.seq_output_head = []
methylseqnet.methylseqnn.MethylSeqNN.merged_output_head = []
methylseqnet.methylseqnn.MethylSeqNN.model_merge_operation = 'multiply'
methylseqnet.methylseqnn.MethylSeqNN.out_tracks=63
methylseqnet.methylseqnn.MethylSeqNN.regression=True
methylseqnet.methylseqnn.MethylSeqNN.pad_all_layers=True
methylseqnet.methylseqnn.MethylSeqNN.crop_off_sequence=155648
methylseqnet.methylseqnn.MethylSeqNN.crop_off_final=64
methylseqnet.methylseqnn.MethylSeqNN.label_threshold_cts=0.5
methylseqnet.methylseqnn.MethylSeqNN.learning_rate=0.002

methylseqnet.trainer.MethylSeqDataModule.train_dataset_file=[
    "/global/scratch/users/dixonluinenburg/atlas_datasets/borzoi-128lzf-multimethyl-bisulfite-atac-cage/fold0.h5",
]
methylseqnet.trainer.MethylSeqDataModule.validation_dataset_file="/global/scratch/users/dixonluinenburg/atlas_datasets/borzoi-128lzf-multimethyl-bisulfite-atac-cage/fold1.h5"
methylseqnet.trainer.MethylSeqDataModule.batch_size=1
methylseqnet.trainer.MethylSeqDataModule.transforms=[]
methylseqnet.trainer.MethylSeqDataModule.dataset_class=@MultiMethylDataset

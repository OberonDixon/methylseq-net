ref_genome = '/clusterfs/nilah/oberon/genomes/hg38.fa'
regions_bed = '/clusterfs/nilah/oberon/repos/methylseq-net/configs/training-splits/borzoi-human/sequences_human.bed'
methylation_directory = '/global/scratch/users/dixonluinenburg/methylation_atlas/GSE186458_RAW'
atac_directory = '/global/scratch/users/dixonluinenburg/atac_atlas/bigwigs'
cage_directory = '/global/scratch/users/dixonluinenburg/cage_atlas/hg38_v9'
match_file = '/clusterfs/nilah/oberon/repos/methylseq-net/configs/cell_type_matching_atac-cage.tsv'
output_directory = '/global/scratch/users/dixonluinenburg/atlas_datasets/borzoi-32-multimethyl-bisulfite-atac-cage/'
label_bin_size = 32
label_num_bins = 16384
seq_length = 524288

MultiMethylWriter.track_length = %label_num_bins
MultiMethylWriter.seq_length = %seq_length
MultiMethylWriter.mask = True

RegionBedParser.regions_bed = %regions_bed
RegionBedParser.seq_length = %seq_length

MultiMethylAtacCageAtlases.ref_genome = %ref_genome
MultiMethylAtacCageAtlases.methylation_directory = %methylation_directory
MultiMethylAtacCageAtlases.atac_directory = %atac_directory
MultiMethylAtacCageAtlases.cage_directory = %cage_directory
MultiMethylAtacCageAtlases.match_file = %match_file
MultiMethylAtacCageAtlases.label_bin_size = %label_bin_size
MultiMethylAtacCageAtlases.label_num_bins = %label_num_bins
MultiMethylAtacCageAtlases.normalize_label_counts = False
MultiMethylAtacCageAtlases.normalize_label_gc = False
MultiMethylAtacCageAtlases.binarize_labels = False

PreprocessingPipeline.sample_generator = @RegionBedParser()
PreprocessingPipeline.multitask_io_handler = @MultiMethylAtacCageAtlases()
PreprocessingPipeline.dataset_writer_class = @MultiMethylWriter
PreprocessingPipeline.output_directory = %output_directory
PreprocessingPipeline.dataset_writer_class = @MultiMethylWriter
PreprocessingPipeline.samples_per_batch = 3



ref_genome = '/clusterfs/nilah/oberon/jupyter/chm13.draft_v1.0.fasta'
methylation_files= ['/clusterfs/nilah/oberon/datasets/deep_ctcf/phased/megalodon/hp2_cpg/pileup.sorted.bed.gz']
target_files = ['/clusterfs/nilah/oberon/datasets/deep_ctcf/phased/megalodon/hp2_ma/pileup.sorted.bed.gz']
output_directory = '/global/scratch/users/dixonluinenburg/atlas_datasets/dimelo-Xinactivation/'
label_bin_size = 128
label_num_bins = 4096
seq_length = 524288

DatasetWriter.track_length = %label_num_bins
DatasetWriter.seq_length = %seq_length
DatasetWriter.cpg_input = True
DatasetWriter.mask = True

ChromosomeChunker.chromosomes_dict = {'HP2':['chrX']}
ChromosomeChunker.fasta_file = %ref_genome
ChromosomeChunker.seq_length = %seq_length
ChromosomeChunker.seq_overlap = 163840

BedMethylIO.ref_genome = %ref_genome
BedMethylIO.methylation_files = %methylation_files
BedMethylIO.target_files = %target_files
BedMethylIO.target_motif = 'A,0'
BedMethylIO.label_bin_size = %label_bin_size
BedMethylIO.label_num_bins = %label_num_bins
BedMethylIO.num_tracks = 63

PreprocessingPipeline.sample_generator = @ChromosomeChunker()
PreprocessingPipeline.multitask_io_handler = @BedMethylIO()
PreprocessingPipeline.dataset_writer_class = @DatasetWriter
PreprocessingPipeline.output_directory = %output_directory



initial_filters = 50
tower_end_filters = 100

methylseqnet.layers.EncodingAdjuster.encoding_str='seq-only'

methylseqnet.layers.ConvDNA.filters=%initial_filters
methylseqnet.layers.ConvDNA.kernel_size=17
methylseqnet.layers.ConvDNA.pool_size=2
methylseqnet.layers.ConvDNA.in_channels=4
methylseqnet.layers.ConvDNA.weight_decay=0

methylseqnet.layers.ConvTower.in_channels=%initial_filters
methylseqnet.layers.ConvTower.filters_init=%initial_filters
methylseqnet.layers.ConvTower.filters_end=%tower_end_filters
methylseqnet.layers.ConvTower.divisible_by=16
methylseqnet.layers.ConvTower.kernel_size=5
methylseqnet.layers.ConvTower.pool_size=2
methylseqnet.layers.ConvTower.repeat=6

methylseqnet.layers.ConvBlock.in_channels=%tower_end_filters
methylseqnet.layers.ConvBlock.filters=256
methylseqnet.layers.ConvBlock.kernel_size=6
methylseqnet.layers.ConvBlock.dilation=1

methylseqnet.layers.ConvDropout.in_channels=256
methylseqnet.layers.ConvDropout.filters=768
methylseqnet.layers.ConvDropout.kernel_size=1
methylseqnet.layers.ConvDropout.dropout=0.2

methylseqnet.layers.ConvFinal.in_channels=768
methylseqnet.layers.ConvFinal.shared_head=False
methylseqnet.layers.ConvFinal.filters=35

methylseqnet.methylseqnn.MethylSeqNN.layers = [@EncodingAdjuster,@ConvDNA,@ConvTower,@ConvBlock,@ConvDropout,@ConvFinal]
methylseqnet.methylseqnn.MethylSeqNN.out_tracks=35 
methylseqnet.methylseqnn.MethylSeqNN.regression=False
methylseqnet.methylseqnn.MethylSeqNN.label_threshold_cts=0.5

methylseqnet.trainer.MethylSeqDataModule.train_dataset_file="/global/scratch/users/dixonluinenburg/atlas_datasets/thresh5_untrimmed_reordered/train.h5"
methylseqnet.trainer.MethylSeqDataModule.validation_dataset_file="/global/scratch/users/dixonluinenburg/atlas_datasets/thresh5_untrimmed_reordered/valid.h5"
methylseqnet.trainer.MethylSeqDataModule.batch_size=16
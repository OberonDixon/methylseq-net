methylseqnet.transforms.ReverseComplement.probability=0.5
methylseqnet.transforms.ReverseComplement.batch_wise=False

methylseqnet.transforms.SequenceJitter.stdev=1
methylseqnet.transforms.SequenceJitter.max_jitter=3
methylseqnet.transforms.SequenceJitter.batch_wise=False

seq_model/methylseqnet.transforms.EncodingSelector.encoding_str='seq-only'
input_to_methyl_rep/methylseqnet.transforms.EncodingSelector.encoding_str='interp-methyl-only'

input_to_methyl_rep/AvgPool1d.kernel_size=128

embeddings_to_seq_rep/methylseqnet.layers.ConvBlock.in_channels=1920
embeddings_to_seq_rep/methylseqnet.layers.ConvBlock.filters=1024
embeddings_to_seq_rep/methylseqnet.layers.ConvBlock.kernel_size=1
embeddings_to_seq_rep/methylseqnet.layers.ConvBlock.pool_size=4
embeddings_to_seq_rep/methylseqnet.layers.ConvBlock.pool_class=@AvgPool1d

embeddings_to_methyl_rep/methylseqnet.layers.ConvBlock.in_channels=1920
embeddings_to_methyl_rep/methylseqnet.layers.ConvBlock.filters=42
embeddings_to_methyl_rep/methylseqnet.layers.ConvBlock.kernel_size=1
embeddings_to_methyl_rep/methylseqnet.layers.ConvBlock.pool_size=4
embeddings_to_methyl_rep/methylseqnet.layers.ConvBlock.pool_class=@AvgPool1d

factorized_reps_to_output_first/methylseqnet.layers.ConvBlock.in_channels=1025
factorized_reps_to_output_first/methylseqnet.layers.ConvBlock.filters=50
factorized_reps_to_output_first/methylseqnet.layers.ConvBlock.kernel_size=1

factorized_reps_to_output_second/methylseqnet.layers.ConvBlock.in_channels=50
factorized_reps_to_output_second/methylseqnet.layers.ConvBlock.filters=25
factorized_reps_to_output_second/methylseqnet.layers.ConvBlock.kernel_size=1

factorized_reps_to_output_third/methylseqnet.layers.ConvBlock.in_channels=25
factorized_reps_to_output_third/methylseqnet.layers.ConvBlock.filters=10
factorized_reps_to_output_third/methylseqnet.layers.ConvBlock.kernel_size=1

factorized_reps_to_output_final/methylseqnet.layers.ConvFinal.in_channels=10
factorized_reps_to_output_final/methylseqnet.layers.ConvFinal.shared_head=False
factorized_reps_to_output_final/methylseqnet.layers.ConvFinal.filters=63

torch.optim.Adam.lr=0.002
torch.optim.Adam.betas=(0.9,0.999)

methylseqnet.pretrained.borzoi_pytorch.pretrained_seq_model_weights='johahi/borzoi-replicate-0'

methylseqnet.methylseqnn.MethylSeqNN.sequence_encoder = [@borzoi_pytorch]
methylseqnet.methylseqnn.MethylSeqNN.conditioning_operation = 'keep_modulator'
methylseqnet.methylseqnn.MethylSeqNN.embeddings_to_unconditional_seq_rep = [
    @embeddings_to_seq_rep/ConvBlock,
]
methylseqnet.methylseqnn.MethylSeqNN.embeddings_to_conditional_seq_rep = [
    @embeddings_to_methyl_rep/ConvBlock,
    @Sigmoid,
]
methylseqnet.methylseqnn.MethylSeqNN.conditioning_state_encoder = [
    @input_to_methyl_rep/EncodingSelector,
    @input_to_methyl_rep/AvgPool1d,
]
methylseqnet.methylseqnn.MethylSeqNN.output_head = [
    @factorized_reps_to_output_first/ConvBlock,
    @factorized_reps_to_output_second/ConvBlock,
    @factorized_reps_to_output_third/ConvBlock,
    @factorized_reps_to_output_final/ConvFinal,
    @Softplus,
]
methylseqnet.methylseqnn.MethylSeqNN.interpolate_conditioning_state_location='output'
methylseqnet.methylseqnn.MethylSeqNN.train_stages={
            'train-factorized-pretrained-embeddings':{
                'grad_dict':{
                    'conditioning_state_encoder':False,
                    'sequence_encoder':False,
                },
                'epochs':1,
            },
        }
methylseqnet.methylseqnn.MethylSeqNN.out_tracks=63
methylseqnet.methylseqnn.MethylSeqNN.regression=True
methylseqnet.methylseqnn.MethylSeqNN.crop_off_output=0
methylseqnet.methylseqnn.MethylSeqNN.crop_off_conditioning_input=163840
# methylseqnet.methylseqnn.MethylSeqNN.concat_pretrained_embeddings_at={}

methylseqnet.trainer.MethylSeqDataModule.train_dataset_file=[
    "./tests/data/borzoi_multimethyl_128/fold0-downsampled.h5",
]
methylseqnet.trainer.MethylSeqDataModule.validation_dataset_file=[
    "./tests/data/borzoi_multimethyl_128/fold0-downsampled.h5",
]
methylseqnet.trainer.MethylSeqDataModule.batch_size=1
methylseqnet.trainer.MethylSeqDataModule.transforms=(@ReverseComplement,@SequenceJitter)
methylseqnet.trainer.MethylSeqDataModule.dataset_class=@MultiMethylDataset
methylseqnet.trainer.MethylSeqDataModule.epoch_size=1

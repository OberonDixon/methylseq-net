methylseqnet.transforms.ReverseComplement.probability=0.5
methylseqnet.transforms.ReverseComplement.batch_wise=False

methylseqnet.transforms.SequenceJitter.stdev=1
methylseqnet.transforms.SequenceJitter.max_jitter=3
methylseqnet.transforms.SequenceJitter.batch_wise=False

seq_model/methylseqnet.transforms.EncodingSelector.encoding_str='seq-only'
input_to_methyl_rep/methylseqnet.transforms.EncodingSelector.encoding_str='interp-methyl-only'

input_to_methyl_rep/AvgPool1d.kernel_size=128
input_to_methyl_rep/Hardtanh.min_val=0.0
input_to_methyl_rep/Hardtanh.max_val=1.0

embeddings_to_methyl_indep_seq_rep/methylseqnet.layers.ConvBlock.in_channels=1920
embeddings_to_methyl_indep_seq_rep/methylseqnet.layers.ConvBlock.filters=1024
embeddings_to_methyl_indep_seq_rep/methylseqnet.layers.ConvBlock.kernel_size=1
embeddings_to_methyl_indep_seq_rep/methylseqnet.layers.ConvBlock.pool_size=4
embeddings_to_methyl_indep_seq_rep/methylseqnet.layers.ConvBlock.pool_class=@AvgPool1d

embeddings_to_methyl_dep_seq_rep/methylseqnet.layers.ConvBlock.in_channels=1920
embeddings_to_methyl_dep_seq_rep/methylseqnet.layers.ConvBlock.filters=1024
embeddings_to_methyl_dep_seq_rep/methylseqnet.layers.ConvBlock.kernel_size=1
embeddings_to_methyl_dep_seq_rep/methylseqnet.layers.ConvBlock.pool_size=4
embeddings_to_methyl_dep_seq_rep/methylseqnet.layers.ConvBlock.pool_class=@AvgPool1d

embeddings_to_methyl_rep/methylseqnet.layers.ConvBlock.in_channels=1920
embeddings_to_methyl_rep/methylseqnet.layers.ConvBlock.filters=43
embeddings_to_methyl_rep/methylseqnet.layers.ConvBlock.kernel_size=1
embeddings_to_methyl_rep/methylseqnet.layers.ConvBlock.pool_size=4
embeddings_to_methyl_rep/methylseqnet.layers.ConvBlock.pool_class=@AvgPool1d

factorized_reps_to_output/methylseqnet.layers.ConvFinal.in_channels=2048
factorized_reps_to_output/methylseqnet.layers.ConvFinal.filters=65
factorized_reps_to_output/methylseqnet.layers.ConvFinal.kernel_size=1

methylseqnet.pretrained.borzoi_pytorch.pretrained_seq_model_weights='johahi/borzoi-replicate-0'

methylseqnet.methylseqnn.MethylSeqNN.encoder_cfg = @borzoi_pytorch
methylseqnet.methylseqnn.MethylSeqNN.encoder_input_head = [@seq_model/EncodingSelector]
methylseqnet.methylseqnn.MethylSeqNN.embeddings_to_unconditional_seq_rep = [
    @embeddings_to_methyl_indep_seq_rep/ConvBlock,
]
methylseqnet.methylseqnn.MethylSeqNN.embeddings_to_conditional_seq_rep = [
    @embeddings_to_methyl_dep_seq_rep/ConvBlock,
]
methylseqnet.methylseqnn.MethylSeqNN.embeddings_to_conditioning_state_rep = [
    @embeddings_to_methyl_rep/ConvBlock,
    @Sigmoid,
]
methylseqnet.methylseqnn.MethylSeqNN.input_to_conditioning_state_rep = [
    @input_to_methyl_rep/EncodingSelector,
    @input_to_methyl_rep/AvgPool1d,
    @input_to_methyl_rep/Hardtanh,
]
methylseqnet.methylseqnn.MethylSeqNN.merged_reps_to_output = [
    @factorized_reps_to_output/ConvFinal,
    @Softplus,
]
methylseqnet.methylseqnn.MethylSeqNN.conditioning_operation = 'multiply'
methylseqnet.methylseqnn.MethylSeqNN.interpolate_conditioning_state_location = 'representation'
methylseqnet.methylseqnn.MethylSeqNN.out_tracks = 65
methylseqnet.methylseqnn.MethylSeqNN.regression = True
methylseqnet.methylseqnn.MethylSeqNN.crop_off_conditioning_input = 163840
methylseqnet.methylseqnn.MethylSeqNN.crop_off_output = 0
methylseqnet.methylseqnn.MethylSeqNN.conditioning_state_rep_loss_weight = 1.0
methylseqnet.methylseqnn.MethylSeqNN.seq_reps_orthogonality_loss_weight = 1.0
methylseqnet.methylseqnn.MethylSeqNN.optimizer_class = @AdamOptimizer
methylseqnet.methylseqnn.MethylSeqNN.train_stages = {
    'train-factorized-pretrained-embeddings': {
        'grad_dict': {
            'encoder': False,
            'encoder_input_head': False,
            'merged_reps_to_output': True,
        },
        'true_methyl_rep_weight': 1.0,
        'epochs': 1,
    },
}

methylseqnet.trainer.MethylSeqDataModule.train_dataset_file={
    "atlas":"./tests/data/borzoi_multimethyl_128/fold0-downsampled.h5",
    "longread":"./tests/data/longread_fold0-downsampled.h5",
}
methylseqnet.trainer.MethylSeqDataModule.validation_dataset_file={
    "atlas":"./tests/data/borzoi_multimethyl_128/fold0-downsampled.h5",
    "longread":"./tests/data/longread_fold0-downsampled.h5",
}
methylseqnet.trainer.MethylSeqDataModule.batch_size=1
methylseqnet.trainer.MethylSeqDataModule.transforms=()
methylseqnet.trainer.MethylSeqDataModule.dataset_class=@MultiMethylDataset
methylseqnet.trainer.MethylSeqDataModule.epoch_size=1

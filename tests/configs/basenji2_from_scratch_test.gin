initial_filters = 30
tower_end_filters = 40

methylseqnet.transforms.ReverseComplement.probability=0.5
methylseqnet.transforms.ReverseComplement.batch_wise=False

methylseqnet.transforms.SequenceJitter.stdev=1
methylseqnet.transforms.SequenceJitter.max_jitter=3
methylseqnet.transforms.SequenceJitter.batch_wise=False

seq_model/methylseqnet.transforms.EncodingSelector.encoding_str='seq-only'
methylseq_model/methylseqnet.transforms.EncodingSelector.encoding_str='seq+interp-methyl+cpg-density'

methylseqnet.layers.ConvDNA.filters=%initial_filters
methylseqnet.layers.ConvDNA.kernel_size=17
methylseqnet.layers.ConvDNA.pool_size=2
methylseqnet.layers.ConvDNA.in_channels=7

methylseqnet.layers.ConvTower.in_channels=%initial_filters
methylseqnet.layers.ConvTower.filters_init=%initial_filters
methylseqnet.layers.ConvTower.filters_end=%tower_end_filters
methylseqnet.layers.ConvTower.divisible_by=16
methylseqnet.layers.ConvTower.kernel_size=5
methylseqnet.layers.ConvTower.pool_size=2
methylseqnet.layers.ConvTower.repeat=6

scaleup_block/methylseqnet.layers.ConvBlock.in_channels=%tower_end_filters
scaleup_block/methylseqnet.layers.ConvBlock.filters=100
scaleup_block/methylseqnet.layers.ConvBlock.kernel_size=1

penultimate_block/methylseqnet.layers.ConvBlock.in_channels=100
penultimate_block/methylseqnet.layers.ConvBlock.filters=3456
penultimate_block/methylseqnet.layers.ConvBlock.kernel_size=1

methylseq_model/methylseqnet.layers.ConvFinal.in_channels=3456
methylseq_model/methylseqnet.layers.ConvFinal.shared_head=False
methylseq_model/methylseqnet.layers.ConvFinal.filters=63

seq_model/methylseqnet.layers.ConvFinal.in_channels=1920
seq_model/methylseqnet.layers.ConvFinal.shared_head=False
seq_model/methylseqnet.layers.ConvFinal.filters=63
seq_model/methylseqnet.layers.ConvFinal.pool_size=4

pool_sequence/AvgPool1d.kernel_size=128
pool_embeddings/AvgPool1d.kernel_size=4

torch.optim.Adam.lr=0.002
torch.optim.Adam.betas=(0.9,0.999)

methylseqnet.pretrained.basenji2_pytorch.pretrained_seq_model_weights=None
methylseqnet.pretrained.basenji2_pytorch.reinitialize=True
methylseqnet.pretrained.basenji2_pytorch.rewrite_conv_dna_channels_to=4

methylseqnet.model.ConditionedSeqNN.sequence_encoder = [@basenji2_pytorch,@seq_model/ConvFinal,@Softplus]
methylseqnet.model.ConditionedSeqNN.output_head = []
methylseqnet.model.ConditionedSeqNN.embeddings_to_unconditional_seq_rep = []
methylseqnet.model.ConditionedSeqNN.embeddings_to_conditional_seq_rep = [@pool_embeddings/AvgPool1d,@ZeroChannels]
methylseqnet.model.ConditionedSeqNN.embeddings_to_conditioning_state_rep = [@pool_embeddings/AvgPool1d,@ZeroChannels]
methylseqnet.model.ConditionedSeqNN.conditioning_state_encoder = []
methylseqnet.model.ConditionedSeqNN.conditioning_operation = 'multiply'
methylseqnet.model.ConditionedSeqNN.train_stages={
            'train-probe-only':{
                'grad_dict':{
                    'sequence_encoder':True,
                },
                'epochs':1,
            },
        }
methylseqnet.model.ConditionedSeqNN.out_tracks=63
methylseqnet.model.ConditionedSeqNN.regression=True
methylseqnet.model.ConditionedSeqNN.crop_off_output=0
methylseqnet.model.ConditionedSeqNN.crop_off_conditioning_input=163840

methylseqnet.datamodule.MethylSeqDataModule.train_dataset_file=[
    "./tests/data/borzoi_multimethyl_128/fold0-downsampled.h5",
]
methylseqnet.datamodule.MethylSeqDataModule.validation_dataset_file=[
    "./tests/data/borzoi_multimethyl_128/fold0-downsampled.h5",
]
methylseqnet.datamodule.MethylSeqDataModule.batch_size=1
methylseqnet.datamodule.MethylSeqDataModule.transforms=(@ReverseComplement,@SequenceJitter)
methylseqnet.datamodule.MethylSeqDataModule.dataset_class=@MultiMethylDataset
methylseqnet.datamodule.MethylSeqDataModule.epoch_size=1

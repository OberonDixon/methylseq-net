ref_genome = '/clusterfs/nilah/oberon/genomes/hg38.fa'
regions_bed = './tests/data/sequences_test.bed'
methylation_bedmethyls_by_phase = (
    '/global/scratch/projects/vector_streetslab/oberon/datasets/vollger_mendelian/fiberseq_bams/GM12878_hp2_whole_genome_CpG/pileup.sorted.bed.gz',
    '/global/scratch/projects/vector_streetslab/oberon/datasets/vollger_mendelian/fiberseq_bams/GM12878_hp1_whole_genome_CpG/pileup.sorted.bed.gz',
)
fiberseq_files_by_phase = (
    '/global/scratch/projects/vector_streetslab/oberon/datasets/vollger_mendelian/FIRE/GM12878_trackHub/bw/hap1.acc.bw',
    '/global/scratch/projects/vector_streetslab/oberon/datasets/vollger_mendelian/FIRE/GM12878_trackHub/bw/hap2.acc.bw',
)
rna_bams_by_phase = (
    '/global/scratch/projects/vector_streetslab/oberon/datasets/vollger_mendelian/rna_bams/GM12878.kinnex.HP1.bam',
    '/global/scratch/projects/vector_streetslab/oberon/datasets/vollger_mendelian/rna_bams/GM12878.kinnex.HP2.bam',
)
unphased_rna_file = '/global/scratch/projects/vector_streetslab/oberon/datasets/vollger_mendelian/rna_bams/GM12878.kinnex.bam'
label_bin_size = 128
label_num_bins = 4096
seq_length = 524288

MultiMethylWriter.track_length = %label_num_bins
MultiMethylWriter.seq_length = %seq_length
MultiMethylWriter.num_variants = 2
MultiMethylWriter.mask = True

RegionBedParser.regions_bed = %regions_bed
RegionBedParser.seq_length = %seq_length

PhasedFiberRNA.sequence_files_by_phase = (%ref_genome,%ref_genome,)
PhasedFiberRNA.methylation_files_by_phase = %methylation_bedmethyls_by_phase
PhasedFiberRNA.fiberseq_files_by_phase = %fiberseq_files_by_phase
PhasedFiberRNA.rna_files_by_phase = %rna_bams_by_phase
PhasedFiberRNA.unphased_rna_file = %unphased_rna_file
PhasedFiberRNA.label_bin_size = %label_bin_size
PhasedFiberRNA.label_num_bins = %label_num_bins

PreprocessingPipeline.sample_generator = @RegionBedParser()
PreprocessingPipeline.multitask_io_handler = @PhasedFiberRNA()
PreprocessingPipeline.dataset_writer_class = @MultiMethylWriter
PreprocessingPipeline.samples_per_batch = 2


